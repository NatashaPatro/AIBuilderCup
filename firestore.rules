rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Any signed-in analyst can read live data (demo scope).
    // Writes only happen from the trusted Cloud Run backend via the
    // Admin SDK, which bypasses these rules entirely - so we deny all
    // client-side writes here.
    match /{document=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}

