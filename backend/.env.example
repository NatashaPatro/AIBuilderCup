# GCP project that hosts Firestore + Vertex AI
GOOGLE_CLOUD_PROJECT=investigate-511912

# Region for Vertex AI Gemini calls
GOOGLE_CLOUD_LOCATION=us-central1

# Set to "true" to use Vertex AI (ADC auth). Set to "false" to use the
# Gemini Developer API with GEMINI_API_KEY instead (simpler, no billing needed).
GOOGLE_GENAI_USE_VERTEXAI=true

# Only needed if GOOGLE_GENAI_USE_VERTEXAI=false
GEMINI_API_KEY=

# Gemini models
GEMINI_FLASH_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-2.5-pro

# Path to a Firebase/GCP service account JSON for local dev.
# Leave empty on Cloud Run (it uses the attached service account automatically).
GOOGLE_APPLICATION_CREDENTIALS=

# Simulator: seconds between each replayed transaction
SIMULATOR_INTERVAL_SECONDS=8

# Comma separated origins allowed to call this API (your Firebase Hosting URL)
ALLOWED_ORIGINS=http://localhost:5173


